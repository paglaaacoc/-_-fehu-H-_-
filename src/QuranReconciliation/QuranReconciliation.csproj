<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>QuranReconciliation</RootNamespace>
    <AssemblyName>The Holy Quran TRP</AssemblyName>
    <ApplicationIcon>Assets\QuranReconciliation.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>The Holy Quran TRP</AssemblyTitle>
    <Product>The Holy Quran TRP</Product>
    <Description>The Holy Quran TRP — workstation for The Holy Translation Reconciliation Project (THTRP)</Description>
    <Version>2.0.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\QuranReconciliation.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="ATTRIBUTION.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <!-- The verified C1 index is staged by the packaging pipeline.
         It is not committed to the authoritative source repository. -->
    <Content Include="Resources\SearchIndex\corpus-search.sqlite"
             Condition="Exists('Resources\SearchIndex\corpus-search.sqlite')">
      <TargetPath>Corpus\corpus-search.sqlite</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <!-- Private/personal derived morphology evidence. Staged only after its
         exact-source checks; canonical Quran and user data remain separate. -->
    <Content Include="Resources\SearchIndex\corpus-lemma-positions.sqlite"
             Condition="Exists('Resources\SearchIndex\corpus-lemma-positions.sqlite')">
      <TargetPath>Corpus\corpus-lemma-positions.sqlite</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\SearchIndex\QAC-MORPHOLOGY-ATTRIBUTION.md"
             Condition="Exists('Resources\SearchIndex\QAC-MORPHOLOGY-ATTRIBUTION.md')">
      <TargetPath>Corpus\QAC-MORPHOLOGY-ATTRIBUTION.md</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="Resources\juz-map.json">
      <TargetPath>Corpus\juz-map.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="Resources\ContextAtlas\BuiltIn\*.b64part">
      <TargetPath>Corpus\ContextAtlas\BuiltIn\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="Resources\Guides\THTRP-User-Guide.html">
      <TargetPath>Guides\THTRP-User-Guide.html</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="Resources\ContextAtlas\HandoffTemplates\**\*">
      <TargetPath>Corpus\ContextAtlas\HandoffTemplates\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
