                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="AtlasReadingTranslation_SelectionChanged"/>
                                <ComboBox x:Name="AtlasReadingBengaliSelector"
                                          Header="Bengali translation"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="AtlasReadingTranslation_SelectionChanged"/>
                            </Grid>
                            <CheckBox x:Name="AtlasReadingSurroundingToggle"
