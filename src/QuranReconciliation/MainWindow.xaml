                                 TextChanged="HistoryWorkspaceSearchTextBox_TextChanged"/>

                        <TextBlock x:Name="HistoryWorkspaceSummaryText"
                                   Grid.Column="1"
                                   Text="All activity"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ListView x:Name="HistoryResultsList"
                              Grid.Row="1"
                              Background="Transparent"
                              SelectionMode="None"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding GroupHeader}"
                                               Height="{Binding GroupHeaderHeight}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SubgroupHeader}"
                                               Height="{Binding SubgroupHeaderHeight}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="14,11"
                                            Margin="0,0,0,9">
                                        <Grid RowSpacing="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Header}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Timestamp}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11.5"/>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Preview}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="13.5"
                                                       LineHeight="20"
                                                       MaxLines="3"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"/>

                                            <Expander Grid.Row="3"
                                                      Header="{Binding DetailsHeader}"
                                                      Expanding="HistoryRowExpander_Expanding"
                                                      IsExpanded="False"
                                                      Margin="0,2,0,0">
                                                <StackPanel Spacing="7"
                                                            Margin="0,6,0,2">
                                                    <TextBlock Text="{Binding Body}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="13"
                                                               LineHeight="20"
                                                               TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True"/>
                                                    <ItemsControl ItemsSource="{Binding Revisions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource PanelAltBrush}"
                                                                        BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="5"
                                                                        Padding="9"
                                                                        Margin="0,3,0,0">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{Binding Header}"
                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                   FontSize="12.5"
                                                                                   FontWeight="SemiBold"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Body}"
                                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                                   FontSize="12.5"
                                                                                   TextWrapping="Wrap"
                                                                                   IsTextSelectionEnabled="True"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>

                                            <Button Grid.Row="4"
                                                    Content="{Binding JumpLabel}"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding CanJump}"
                                                    HorizontalAlignment="Left"
                                                    Padding="12,5"
                                                    Margin="0,4,0,0"
                                                    Click="HistoryJumpToTarget_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button x:Name="HistoryLoadMoreButton"
                            Grid.Row="2"
                            Content="Load more"
                            HorizontalAlignment="Center"
                            Padding="16,7"
                            Margin="0,10,0,0"
                            Visibility="Collapsed"
                            Click="LoadMoreHistory_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="ContextAtlasWorkspaceGrid"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="{StaticResource AppBackgroundBrush}"
              Padding="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="← Back to research"
