                                           FontWeight="SemiBold"
                                           Margin="10,0,0,0"/>
                                <Button Grid.Column="3"
                                        Content="Close Preview"
                                        Click="AtlasReadingClose_Click"
                                        Padding="10,6"/>
                            </Grid>
                            <Grid Grid.Row="1"
                                  ColumnSpacing="12"
                                  Margin="0,10,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="AtlasReadingEnglishSelector"
