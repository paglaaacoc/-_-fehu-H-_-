                                Padding="12,5"
                                Click="AtlasTabButton_Click"/>
                        <Button x:Name="AtlasWorksetsTabButton"
                                Content="Related Worksets"
                                Tag="Related Worksets"
                                Padding="12,5"
                                Click="AtlasTabButton_Click"/>
                        <Button x:Name="AtlasReviewTabButton"
