                                                        Padding="0,0,6,16"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Transient reading only. Never creates Working Slices or writes research state. -->
                        <Grid x:Name="AtlasReadingPreviewGrid"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
