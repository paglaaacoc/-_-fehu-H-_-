                                     GroupName="HistoryFilter"
                                     Tag="All"
                                     IsChecked="True"
                                     Checked="HistoryFilter_Checked"/>
                        <RadioButton Content="Ayah notes"
                                     GroupName="HistoryFilter"
                                     Tag="AyahNotes"
                                     Checked="HistoryFilter_Checked"/>
                        <RadioButton Content="Context notes"
                                     GroupName="HistoryFilter"
                                     Tag="ContextNotes"
                                     Checked="HistoryFilter_Checked"/>
                        <RadioButton Content="Context activity"
                                     GroupName="HistoryFilter"
                                     Tag="Context"
                                     Checked="HistoryFilter_Checked"/>
                        <RadioButton Content="Working Slices"
                                     GroupName="HistoryFilter"
                                     Tag="WorkingSlices"
                                     Checked="HistoryFilter_Checked"/>
                        <RadioButton Content="Bookmarks"
                                     GroupName="HistoryFilter"
                                     Tag="Bookmarks"
                                     Checked="HistoryFilter_Checked"/>

