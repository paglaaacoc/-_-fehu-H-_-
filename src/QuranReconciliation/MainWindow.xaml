                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="AtlasCompareReadingLeftTitle"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>
                                        <ScrollViewer x:Name="AtlasCompareReadingLeftScroll"
