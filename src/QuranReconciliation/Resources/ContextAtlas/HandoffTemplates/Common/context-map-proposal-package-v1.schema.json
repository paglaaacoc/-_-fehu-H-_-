{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nivareq.com/schemas/thtrp-context-map-proposal-package-v1.schema.json",
  "title": "THTRP Context Atlas import ZIP manifest v1",
  "type": "object",
  "required": [
    "package_schema",
    "package_schema_version",
    "package_type",
    "corpus_id",
    "display_name",
    "edition",
    "published_date",
    "payload_file",
    "payload_sha256",
    "terminology_standard"
  ],
  "properties": {
    "package_schema": {
      "const": "thtrp.context-map-proposal-package"
    },
    "package_schema_version": {
      "const": 1
    },
    "package_type": {
      "const": "proposal_corpus"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": "integer",
      "minimum": 1
    },
    "published_date": {
      "type": "string",
      "format": "date"
    },
    "payload_file": {
      "const": "proposal-corpus.json"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "terminology_standard": {
      "type": "string",
      "minLength": 1
    }
  }
}
